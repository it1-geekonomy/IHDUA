# Copy to .env.prod (repo root) on the server and fill in real values.
# Generate secrets with: openssl rand -hex 32
# Run compose with: docker compose --env-file .env.prod -f docker-compose.prod.yml ...
# Never commit .env.prod — it is gitignored.

# Public address of the site, no trailing slash.
# Use http://<droplet-ip> until a domain is set up, then https://yourdomain.
# Changing this requires rebuilding the frontend (NEXT_PUBLIC_* are build-time).
PUBLIC_URL=http://165.22.217.143

# --- Postgres (internal to the server, never exposed publicly) ---
DB_USERNAME=ihdua
DB_PASSWORD=CHANGE_ME_openssl_rand_hex_32
DB_NAME=ihdua_db

# --- Auth (NestJS JWT) ---
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_EXPIRES_IN=7d

# --- First CMS admin (used by: docker compose exec backend pnpm run seed:admin:prod) ---
ADMIN_EMAIL=admin@ihdua.org
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=IHDUA Admin

# --- Backend <-> AI chatbot shared secret ---
AI_SERVICE_INTERNAL_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Cloudflare R2 (ihdua-assets) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ihdua-assets
R2_ENDPOINT=https://48d1b5c60d0de2d588b9c7810aae2d30.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://pub-a6675db0619c4dcfa4dbe2528e4f1daa.r2.dev
R2_REGION=auto

# Optional: hosts allowed for /api/download (comma-separated)
DOWNLOAD_ALLOWED_HOSTS=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- FCRA remittance (optional; shown to foreign donors) ---
FCRA_ACCOUNT_NAME=International Human Development and Upliftment Academy
FCRA_BANK_NAME=State Bank of India
FCRA_BRANCH=New Delhi Main Branch
FCRA_ACCOUNT_NUMBER=
FCRA_IFSC=SBIN0000691
FCRA_SWIFT=SBININBB104
FCRA_CONTACT_EMAIL=info@ihdua.org

# --- Resend (donation / notification emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@ihdua.org
SUBMISSION_NOTIFICATION_EMAIL=sachin@geekonomy.in

# --- OpenAI (chatbot) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=14

# --- Chatbot retrieval / chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K_CHUNKS=4
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
CONVERSATION_MEMORY_SIZE=6
