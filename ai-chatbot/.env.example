# --- Server ---
PORT=8001

# --- Postgres with pgvector ---
DB_HOST=localhost
DB_PORT=5435
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=ihdua_db

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Chunking & Retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
CONVERSATION_MEMORY_SIZE=6

# --- Security: Shared internal key between Next.js and FastAPI ---
INTERNAL_API_KEY=your_strong_random_secret_here

# --- Site URL for live indexing ---
SITE_CRAWL_URL=http://localhost:3000
SITE_BASE_URL=https://ihdua.org
